APP_NAME=Calligraphy RAG Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
APP_DEBUG=false

DB_DRIVER=pymysql
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=calligraphy_rag
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ECHO=false
DB_POOL_PRE_PING=true
RAG_CHUNK_SIZE=260
RAG_CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=4
EMBEDDING_DIMENSIONS=24
EMBEDDING_PROVIDER=hashed-demo
EMBEDDING_MODEL=hash-embedding-v1
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.2
QWEN_TIMEOUT_SECONDS=20

API_AUTH_ENABLED=true
API_AUTH_HEADER_NAME=x-api-key
API_AUTH_KEY=replace_with_your_strong_api_key
API_AUTH_EXEMPT_PATHS=/docs,/openapi.json,/redoc,/api/v1/health

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/docs,/openapi.json,/redoc,/api/v1/health

SECURITY_ALERT_SLOW_REQUEST_MS=2000
